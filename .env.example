# Server
PORT=3000
NODE_ENV=development

# Public URL of THIS auth service (used as the JWT "iss" claim)
AUTH_SERVICE_URL=http://localhost:3000

# Where to redirect the browser after OAuth login; also the base for invite links
CLIENT_URL=http://localhost:5173

# Postgres connection string (docker-compose up gives you this one for free)
DATABASE_URL=postgres://auth:auth@localhost:5432/auth

# Comma-separated list of allowed origins, or "*" to allow any (tighten later
# without a code change — see src/api/index.ts)
CORS_ORIGINS=*

# RSA keypair used to sign/verify JWTs, base64-encoded PEM.
# Generate with: bun run generate-keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-key-1

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Invite link lifetime — compact duration, unit one of s/m/h/d/w/y (1y = 365d)
INVITE_TOKEN_TTL=1d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
